{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "three-pager-exec.schema.json",
  "title": "THREE_PAGER_PORTFOLIO_AI v0.3 — payload profil exec",
  "type": "object",
  "required": ["template", "template_version", "render_profile", "program", "entity", "entity_id", "language", "cutoff", "lineage", "figures", "drivers", "themes", "transformation", "posture", "page1", "page2", "page3"],
  "properties": {
    "template": {"const": "THREE_PAGER_PORTFOLIO_AI"},
    "template_version": {"type": "string", "pattern": "^0\\.3\\.\\d+-exec$"},
    "render_profile": {"const": "exec"},
    "program": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "language": {"enum": ["fr", "en", "es"]},
    "cutoff": {"type": "string", "format": "date"},
    "lineage": {"type": "object", "required": ["repo", "repo_commit", "bundle", "status_in_repo"],
      "properties": {"repo": {"type": "string"}, "repo_commit": {"type": "string"}, "bundle": {"type": "string"},
                     "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                     "evidence_delta": {"type": "array", "items": {"type": "string"}}, "status_in_repo": {"type": "string"}}},
    "figures": {"type": "object", "minProperties": 3, "additionalProperties": {
      "type": "object", "required": ["value", "src", "kind"],
      "properties": {"value": {"type": "string"}, "src": {"type": "string"}, "kind": {"enum": ["fact", "calc"]}, "calc": {"type": "string"}},
      "if": {"properties": {"kind": {"const": "calc"}}}, "then": {"required": ["calc"]}}},
    "drivers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["id", "label", "text"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string", "maxLength": 22}, "text": {"type": "string", "maxLength": 110}}}},
    "themes": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "object",
      "required": ["n", "name", "stars", "drivers", "activity", "strategy", "strategy_family", "horizon", "change", "benefit", "advantage", "feature"],
      "properties": {"n": {"type": "integer", "minimum": 1, "maximum": 5}, "name": {"type": "string", "maxLength": 40},
        "stars": {"type": "integer", "minimum": 1, "maximum": 3}, "drivers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "activity": {"type": "string"}, "strategy": {"type": "string"},
        "strategy_family": {"enum": ["cost", "cash", "differentiation", "resilience"]},
        "horizon": {"type": "string"}, "change": {"type": "string", "maxLength": 90}, "benefit": {"type": "string", "maxLength": 60},
        "advantage": {"type": "string", "maxLength": 60}, "feature": {"type": "string", "maxLength": 50}}}},
    "transformation": {"type": "object", "required": ["covers", "mt", "lt", "take"],
      "properties": {"covers": {"type": "array", "items": {"type": "string"}}, "mt": {"type": "string"}, "lt": {"type": "string"}, "take": {"type": "string"}}},
    "posture": {"type": "object", "required": ["current", "label"],
      "properties": {"current": {"enum": ["S-O", "S-T", "W-T", "W-O"]}, "label": {"enum": ["offensive", "défensive", "de veille", "opportuniste"]},
                     "option": {"enum": ["S-O", "S-T", "W-T", "W-O"]}}},
    "layout": {"type": "object", "description": "surcharges de grille optionnelles ; jamais de taille de police"},
    "page1": {"type": "object", "required": ["subtitle", "signaletique", "thesis", "drivers_take", "breakdown", "board", "swot", "footer", "sources"],
      "properties": {
        "subtitle": {"type": "string", "maxLength": 130},
        "signaletique": {"type": "object", "required": ["rows", "take"], "properties": {"rows": {"type": "array", "minItems": 5, "maxItems": 6}, "take": {"type": "string", "minLength": 5}}},
        "thesis": {"type": "object", "required": ["paras", "take"], "properties": {"paras": {"type": "array", "minItems": 2, "maxItems": 2}, "take": {"type": "string", "minLength": 5}}},
        "board": {"type": "object", "required": ["intro", "rows", "take"], "properties": {"rows": {"type": "array", "minItems": 2, "maxItems": 4,
          "items": {"type": "object", "required": ["who", "what"], "properties": {"who": {"type": "string"}, "what": {"type": "string"}, "role": {"type": ["string", "null"]}, "gap": {"type": "boolean"}}}}}},
        "swot": {"type": "object", "required": ["s", "w", "o", "t", "take"],
          "properties": {"s": {"type": "array", "maxItems": 3}, "w": {"type": "array", "maxItems": 3}, "o": {"type": "array", "maxItems": 3}, "t": {"type": "array", "maxItems": 3}}},
        "footer": {"$ref": "#/$defs/footer"}}},
    "page2": {"type": "object", "required": ["subtitle", "support", "primary", "margin_sub", "metrics", "lecture", "footer", "sources", "top_count"],
      "properties": {"support": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/activity"}},
                     "primary": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/activity"}},
                     "top_count": {"type": "integer"}, "footer": {"$ref": "#/$defs/footer"}}},
    "page3": {"type": "object", "required": ["subtitle", "quadrant", "themes_title", "themes_take", "ai_diag", "dominant", "footer", "sources"],
      "properties": {"quadrant": {"type": "object", "required": ["cells", "take"], "properties": {"cells": {"type": "array", "minItems": 5, "maxItems": 10,
          "items": {"type": "object", "required": ["row", "col", "label"], "properties": {"row": {"enum": ["Core", "Enabler", "Support"]},
            "col": {"enum": ["Commodity", "Parity", "Differentiating"]}, "label": {"type": "string", "maxLength": 32}, "theme": {"type": "integer"}}}}}},
        "ai_diag": {"type": "object", "required": ["level", "facts", "take"], "properties": {"level": {"enum": ["Faible", "Partiel", "Établi"]}, "facts": {"type": "array", "minItems": 2, "maxItems": 3}}},
        "footer": {"$ref": "#/$defs/footer"}}}
  },
  "$defs": {
    "footer": {"type": "object", "required": ["label", "body"], "properties": {"label": {"type": "string", "maxLength": 40}, "body": {"type": "string", "maxLength": 330}}},
    "activity": {"type": "object", "required": ["name", "stars", "desc", "benefit"],
      "properties": {"name": {"type": "string"}, "stars": {"type": "integer", "minimum": 1, "maximum": 3}, "desc": {"type": "string", "maxLength": 130},
                     "benefit": {"type": "string", "maxLength": 45}, "themes": {"type": "array", "items": {"type": "integer"}}, "transformation": {"enum": ["MT", "LT"]}}}
  }
}
